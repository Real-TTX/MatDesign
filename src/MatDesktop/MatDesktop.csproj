<Project Sdk="Microsoft.NET.Sdk">

  <!-- MatDesktop: the toolkit for the desktop programs of the Mat apps (docs/DESKTOP.md): the theme with the tokens, the window chrome, the menu, the tray, the Info window, the setup
       window and the controls, as one Avalonia library. Apps COPY these files (CODE-03), with tools/matdesktop-copy.js; this project is where they are built and tested. It is not
       part of the site or its image. Tokens/MatTokens.g.cs and Themes/MatIcons.axaml are generated by tools/desktop.js from MatUi (never edited by hand). -->
  <PropertyGroup>
    <RootNamespace>MatDesktop</RootNamespace>
    <AssemblyName>MatDesktop</AssemblyName>
    <IsPackable>false</IsPackable>
    <AvaloniaVersion>11.3.22</AvaloniaVersion>
    <!-- The version of the package (semantic versioning). Change it together with MatDesktopInfo.Version (a test holds them equal). -->
    <MatDesktopVersion>0.2.0</MatDesktopVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
  </ItemGroup>

</Project>
