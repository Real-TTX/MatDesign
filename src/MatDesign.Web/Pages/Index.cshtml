@page "/"
@inject ToolkitFiles Toolkit
@inject MatDesign.Web.Studio.DesignData Design
@{
    ViewData["Title"] = "Overview";
    ViewData["OwnHead"] = true;
    var firstRules = new[] { "SHELL-01", "SHELL-03", "SHELL-07", "SHELL-08", "LIST-03", "FORM-01", "DIALOG-03", "IDENT-01" }
        .Select(id => Design.Rule(id)!).ToList();
    var apps = Design.Apps;
    var tenant = Design.Tenant;
    var pages = new (string Name, string Href, string Text)[]
    {
        ("Foundations", "/Foundations", "Colour, type, space, shape, motion and the icons."),
        ("Components", "/Components", "Every control, forms and pickers included, live and with its markup."),
        ("Layout", "/Layout", "Breakpoints, containers and the grid of twelve columns."),
        ("Utilities", "/Utilities", "Spacing, display, flex, text, colour and sizing: one class, one property."),
        ("Patterns", "/Patterns", "List page, edit page, sign-in and settings, on a desktop and on a phone."),
        ("Builder", "/Builder", "Try an accent colour in both modes and check the contrast."),
        ("Audit", "/Identity/Audit", "How close each app is to the rules today."),
        ("Download", "/Download", "The CSS, the script and the icon sprite, and the rules as JSON."),
    }.Where(entry => entry.Href != "/Identity/Audit" || Design.Template.OffersAudit).ToArray();
}

@functions {
    // The first sentence of a rule: enough to recognise it in a list.
    private static string First(string text)
    {
        var end = text.IndexOf(". ", StringComparison.Ordinal);
        return end < 0 ? text : text[..(end + 1)];
    }
}

<header class="doc-intro">
    <h1>@tenant.SiteName</h1>
    <p>
        How the @tenant.Apps are meant to look. The rulebook lists the rules, the components show them at work, and <code>MatUi</code>
        is the CSS and script an app copies to follow them.
    </p>
    <p class="mat-muted">
        <a href="/Rules">@Design.Rules.Count rules</a> in @RuleBook.Areas.Count areas, <a href="/Identity">@apps.Count @(apps.Count == 1 ? "app" : "apps")</a>,
        <a href="/Foundations/Tokens">@Toolkit.Tokens.Count design tokens</a> and <a href="/Foundations/Icons">@Toolkit.IconNames.Count icons</a>.
    </p>
    <div class="mat-btn-row mat-btn-row--plain">
        <a class="mat-btn mat-btn--primary" href="/Rules">@Ui.Icon("book")<span>Rulebook</span></a>
        <a class="mat-btn mat-btn--secondary" href="/Download">@Ui.Icon("download")<span>Get MatUi</span></a>
    </div>
</header>

<section class="mat-section" aria-labelledby="first-title">
    <div class="mat-section__head">
        <h2 id="first-title">The rules you notice first</h2>
        <p class="mat-section__lead">The menu is on the left with the logo above it, the breadcrumb sits above the content, every list has a toolbar, and the buttons are under the content. <a href="/Shell">The shell</a> shows it.</p>
    </div>
    <ul class="doc-index">
        @foreach (var rule in firstRules)
        {
            <li>
                <a class="doc-index__row" href="/Rules/Detail?id=@rule.Id">
                    <span class="doc-index__key doc-index__key--mono">@rule.Id</span>
                    <span class="doc-index__body">
                        <strong class="doc-index__title">@rule.Title</strong>
                        <span class="mat-muted">@Ui.Inline(First(rule.Statement))</span>
                    </span>
                </a>
            </li>
        }
    </ul>
</section>

<section class="mat-section" aria-labelledby="family-title">
    <div class="mat-section__head">
        <h2 id="family-title">The apps</h2>
        <p class="mat-section__lead">Each has one accent colour of its own. Everything else is shared.</p>
    </div>
    @if (apps.Count == 0)
    {
        <div class="mat-empty">
            <span class="mat-empty__icon">@Ui.Icon("apps")</span>
            <div class="mat-empty__title">No apps yet</div>
            <p>@tenant.Company has no apps on this site. Add the first one in the Studio: a name, a colour and an icon.</p>
            <a class="mat-btn mat-btn--primary" href="/Studio/Apps/Edit">@Ui.Icon("plus")<span>Add the first app</span></a>
        </div>
    }
    else
    {
        <div class="mat-grid">
            @foreach (var app in apps)
            {
                <a class="mat-card doc-app" href="/Identity/App?id=@app.Id" data-app="@app.Id">
                    @Ui.Logo(app)
                    <span class="doc-app__text">
                        <span class="doc-app__name">@app.Name</span>
                        <span class="doc-app__line">@app.Tagline</span>
                    </span>
                </a>
            }
        </div>
    }
</section>

<section class="mat-section" aria-labelledby="inside-title">
    <div class="mat-section__head"><h2 id="inside-title">Where to look</h2></div>
    <ul class="doc-index">
        @foreach (var entry in pages)
        {
            <li>
                <a class="doc-index__row" href="@entry.Href">
                    <span class="doc-index__key"><strong class="doc-index__title">@entry.Name</strong></span>
                    <span class="doc-index__body"><span class="mat-muted">@entry.Text</span></span>
                </a>
            </li>
        }
    </ul>
</section>
