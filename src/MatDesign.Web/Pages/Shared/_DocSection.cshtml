@model CatalogSection
@inject MatDesign.Web.Studio.DesignData Design
@*
    A page of the documentation of the toolkit that shows some groups of the catalogue (the components, the layout, the utilities): an index beside the
    content (SHELL-16; below 1100 px an icon in the header bar opens it in the dialog at the end of this partial, the page sets ViewData["IndexDialog"]),
    and for each group its components with live examples, the markup to copy and the rules.
*@
@{
    var isComponents = Model.Id == "components";
}
<div class="mat-with-toc">
    <div class="mat-with-toc__main">
        <p class="mat-muted">
            Every example is live and shows its code with it, to copy: beside the example on a wide window, below it on a narrow one.
            Ids such as <a href="/Rules/Detail?id=FORM-01">FORM-01</a> are the rules from the rulebook that the example follows.
            @if (isComponents)
            {
                <text>The <a href="/Patterns">patterns</a> put the controls together in whole pages. This is every component on one page, for printing and for searching with the browser; the <a href="@ComponentCatalog.OverviewPath">overview</a> has a tile for each, and each has a page of its own.</text>
            }
            else
            {
                <text>The <a href="/Components">components</a> use these classes; sizes, colours and spaces come from the <a href="/Foundations">tokens</a>.</text>
            }
        </p>

        <div class="doc-view" role="group" aria-label="Where the code is shown">
            <span class="doc-view__label">Code</span>
            <div class="mat-seg">
                <button type="button" class="mat-seg__btn" data-doc-code="beside" aria-pressed="true"><span>Beside the example</span></button>
                <button type="button" class="mat-seg__btn" data-doc-code="below" aria-pressed="false"><span>Below it</span></button>
            </div>
        </div>

        @foreach (var group in Model.Groups)
        {
            var anchor = ComponentCatalog.GroupAnchor(group);
            <section class="doc-group mat-anchor" id="@anchor" aria-labelledby="h-@anchor">
                <div class="mat-section__head">
                    <h2 id="h-@anchor">@group</h2>
                    <p class="mat-section__lead">@ComponentCatalog.GroupSummaries[group]</p>
                </div>
                @if (ContextPages.For(group) is { } context)
                {
                    <partial name="_ContextPage" model="context" />
                }
                <div class="doc-components">
                    @foreach (var component in Design.ComponentsOf(group))
                    {
                        <partial name="_Component" model="component" />
                    }
                </div>
            </section>
        }

        <div class="mat-actions">
            @if (isComponents)
            {
                <a class="mat-btn mat-btn--secondary" href="/Patterns">@Ui.Icon("template")<span>See them in pages</span></a>
            }
            else
            {
                <a class="mat-btn mat-btn--secondary" href="/Components">@Ui.Icon("toggle")<span>See the components</span></a>
            }
            <a class="mat-btn mat-btn--secondary" href="/Download">@Ui.Icon("download")<span>Download the toolkit</span></a>
        </div>
    </div>

    <aside class="mat-toc-aside" aria-label="Index of this page">
        <partial name="_Toc" model="Model" />
    </aside>
</div>

<dialog class="mat-dialog mat-dialog--sm" id="toc-dialog" aria-labelledby="toc-dialog-title">
    <div class="mat-dialog__form">
        <div class="mat-dialog__head">
            @Ui.Icon("list")
            <h2 class="mat-dialog__title" id="toc-dialog-title">On this page</h2>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Close">@Ui.Icon("x")</button>
        </div>
        <div class="mat-dialog__body"><partial name="_Toc" model="Model" /></div>
    </div>
</dialog>
