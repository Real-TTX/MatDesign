@model ComponentDoc
@inject MatDesign.Web.Studio.DesignData Design
@*
    One component on the components page: what it is, the rules it follows, each example live with its markup (or script) to copy, and what is good to know.
    The ids of the elements are prefixed with the id of the component: all components share one page.
*@
@{
    var c = Model;
    var n = 0;
}
<section class="doc-component mat-anchor" id="@c.Id" aria-labelledby="h-@c.Id">
    <header class="doc-component__head">
        <div class="mat-stack mat-stack--sm">
            <h3 id="h-@c.Id">@c.Name <a class="doc-anchor-link" href="#@c.Id" aria-label="Link to @c.Name">#</a></h3>
            <p class="mat-muted">@c.Summary</p>
            <div class="mat-row doc-rules">
                @foreach (var rule in c.Rules)
                {
                    <a class="doc-rule-id" href="/Rules/Detail?id=@rule" title="@Design.Rule(rule)?.Title">@rule</a>
                }
            </div>
        </div>
    </header>

    @foreach (var ex in c.Examples)
    {
        n++;
        var sourceId = $"src-{c.Id}-{n}";
        <div class="doc-example" role="group" aria-labelledby="ex-@c.Id-@n">
            <div class="doc-example__head">
                <h4 id="ex-@c.Id-@n">@ex.Title</h4>
                @if (ex.Note is not null) { <p>@Ui.Rich(ex.Note)</p> }
            </div>

            @if (ex.Live && ex.Html.Length > 0)
            {
                <div class="doc-example__live@(ex.Frame is null ? string.Empty : " doc-example__live--" + ex.Frame)">@Html.Raw(ex.Html)</div>
            }
            else if (ex.Demo is not null)
            {
                <div class="doc-example__live">
                    <div class="mat-row"><button type="button" class="mat-btn mat-btn--secondary" data-doc-demo="@ex.Demo">@Ui.Icon("play")<span>Try it</span></button></div>
                </div>
            }

            <details class="doc-example__code" open="@(!ex.Live || ex.Html.Length == 0)">
                <summary>@(ex.Js is not null ? "Script" : "Markup")</summary>
                <div class="mat-stack mat-stack--sm">
                    <pre class="mat-code" id="@sourceId"><code>@(ex.Js ?? ex.Html)</code></pre>
                    <div class="mat-row">
                        <button type="button" class="mat-btn mat-btn--ghost mat-btn--sm" data-copy="#@sourceId">@Ui.Icon("copy")<span>Copy</span></button>
                        @if (ex.Js is not null && ex.Demo is not null && ex.Live && ex.Html.Length > 0)
                        {
                            <button type="button" class="mat-btn mat-btn--ghost mat-btn--sm" data-doc-demo="@ex.Demo">@Ui.Icon("play")<span>Try it</span></button>
                        }
                    </div>
                </div>
            </details>
        </div>
    }

    @if (c.Behaviour.Count > 0)
    {
        <div class="doc-know">
            <h4>Good to know</h4>
            <ul class="doc-list">
                @foreach (var line in c.Behaviour) { <li>@Ui.Rich(line)</li> }
            </ul>
        </div>
    }
</section>
