@model ComponentDoc
@inject MatDesign.Web.Studio.DesignData Design
@inject MatDesign.Web.Services.ToolkitFiles Toolkit
@*
    One component on the components page: what it is, the rules it follows, the classes and attributes it uses, each example live with its code beside it
    (below on a narrow window, and for examples that need the width), and what is good to know. The code is always shown, highlighted, with a Copy button.
    This is a component on the page of everything (/Components/All, Layout and Utilities); the page of one component is Pages/Components/Detail.cshtml, which draws the examples
    with the same partial. The ids of the elements are prefixed with the id of the component: all components share one page.
*@
@{
    var c = Model;
    const int ApiShown = 14; // the classes that are listed at once; the rest opens with "+n more"
    var classes = ComponentApi.Classes(c);
    var attributes = ComponentApi.Attributes(c);
    var properties = MatDesign.Core.ComponentProperties.ForDoc(Toolkit.Properties, c.Id);
}
<section class="doc-component mat-anchor" id="@c.Id" aria-labelledby="h-@c.Id">
    <header class="doc-component__head">
        <div class="mat-stack mat-stack--sm">
            <h3 id="h-@c.Id">@c.Name <a class="doc-anchor-link" href="#@c.Id" aria-label="Link to @c.Name">#</a></h3>
            <p class="mat-muted">@c.Summary</p>
            <div class="mat-row doc-rules">
                @foreach (var rule in c.Rules)
                {
                    <a class="doc-rule-id" href="/Rules/Detail?id=@rule" title="@Design.Rule(rule)?.Title">@rule</a>
                }
            </div>
            @if (classes.Count > 0 || attributes.Count > 0)
            {
                <dl class="doc-api">
                    @if (classes.Count > 0)
                    {
                        <dt>Classes</dt>
                        <dd>
                            @for (var i = 0; i < classes.Count; i++)
                            {
                                <code class="@(i >= ApiShown ? "doc-api__extra" : null)">@classes[i]</code>
                            }
                            @if (classes.Count > ApiShown)
                            {
                                <button type="button" class="doc-api__more" data-doc-api-more aria-expanded="false" data-more="+@(classes.Count - ApiShown) more">+@(classes.Count - ApiShown) more</button>
                            }
                        </dd>
                    }
                    @if (attributes.Count > 0)
                    {
                        <dt>Attributes</dt>
                        <dd>@foreach (var a in attributes) { <code>@a</code> }</dd>
                    }
                </dl>
            }
        </div>
        @if (ContextPages.Of(c.Id) is not null)
        {
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--sm doc-show" data-context-show="@ComponentCatalog.GroupAnchor(c.Group)" data-context-component="@c.Id">@Ui.Icon("monitor")<span>Show in a page</span></button>
        }
    </header>

    <partial name="_ComponentExamples" model="(c, 4)" />

    @if (properties.Count > 0)
    {
        <div class="doc-example" role="group" aria-labelledby="props-@c.Id">
            <div class="doc-example__head">
                <h4 id="props-@c.Id">Properties</h4>
                <p>Set these on <code>:root</code>, on <code>[data-app]</code> or on one element to change the shape of the control. Unset, the control uses the default shown (<a href="/Rules/Detail?id=SPACE-06">SPACE-06</a>, <a href="/Foundations/Tokens#component-properties">all properties</a>).</p>
            </div>
            <partial name="_ComponentProperties" model="properties" />
        </div>
    }

    @if (c.Behaviour.Count > 0)
    {
        <div class="doc-know">
            <h4>Good to know</h4>
            <ul class="doc-list">
                @foreach (var line in c.Behaviour) { <li>@Ui.Rich(line)</li> }
            </ul>
        </div>
    }
</section>
