@model (ShellModel Shell, string? Active, bool Foot)
@*
    The button of the menu switcher (SHELL-15): under the logo, or at the foot of the menu directly above the user (Foot), or both. Every button opens the same popup
    (_MenuSwitchPopup), which is drawn at the end of the page: from the top it opens downwards, from the foot upwards. A menu that has a parent shows the name of the
    parent above its own name.
*@
@{
    var shell = Model.Shell;
    var current = shell.CurrentMenu(Model.Active);
}
<div class="mat-nav__switch@(Model.Foot ? " mat-nav__switch--foot" : string.Empty)">
    <button type="button" class="mat-switcher" data-menu-toggle="nav-switch-menu" data-menu-place="@(Model.Foot ? "top" : "bottom")" aria-haspopup="menu" aria-expanded="false">
        <span class="mat-switcher__icon">@Ui.Icon(current.Icon)</span>
        <span class="mat-switcher__text"><small data-nav-label="Menu">@(current.Parent?.Title ?? "Menu")</small><span class="mat-switcher__name">@current.Title</span></span>
        @Ui.Icon(Model.Foot ? "chevron-up" : "chevron-down", "mat-switcher__chev")
        <span class="mat-switcher__dot" hidden="@(!shell.Menus.Any(m => m != current && m.NeedsAttention))"></span>
    </button>
</div>
