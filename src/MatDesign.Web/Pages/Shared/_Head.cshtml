@using MatDesign.Core.Studio
@inject ToolkitFiles Toolkit
@inject MatDesign.Web.Studio.DesignData Design
@model (ShellModel Shell, string Title)
@*
    The <head> of every page: the toolkit from one URL (the site eats its own dog food), the boot script that applies the saved theme before the
    first paint, and the few documentation-only styles of this site.
*@
@{
    // The favicon and the app icon of the brand (IDENT-08), on the site's own pages only (a preview of a sample app keeps its own); without them the link is the one the site always had.
    var brand = ViewData["Shell"] is null ? Design.Assets : null;
    var faviconType = brand?.Favicon is { } brandFavicon ? Ui.FaviconType(brandFavicon) : "image/svg+xml";
    var faviconHref = brand?.Favicon is { } brandIcon ? Ui.BrandUrl(BrandAssets.PublicName("favicon", brandIcon)) : Url.Content("~/favicon.svg");
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="@Model.Shell.App.Accent" />
    <title>@Model.Title · @Model.Shell.App.Name</title>
    <link rel="icon" type="@Html.Raw(faviconType)" href="@faviconHref" />@Ui.AppIconLink(brand)
    <script src="/ui/matui.boot.js?v=@Toolkit.Hash"></script>
    <link rel="stylesheet" href="/ui/matui.css?v=@Toolkit.Hash" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
