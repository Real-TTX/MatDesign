@page "/Identity/Palette"
@model MatDesign.Web.Pages.Identity.PaletteModel
@{
    ViewData["Title"] = "Palette";
    ViewData["PageSub"] = "Can you tell the apps apart by their colour? A report on how close the accents are, with free colours as proposals.";
    ViewData["Crumbs"] = Crumbs.Of(("Identity", "/Identity"), ("Palette", null));
}

<section class="mat-card" aria-labelledby="strip-title">
    <div class="mat-card__head">@Ui.Icon("palette")<h2 class="mat-card__title" id="strip-title">All accents around the colour wheel</h2></div>
    <div class="mat-card__body mat-stack">
        <p class="mat-muted">Sorted by hue. Neighbours that look alike are the ones in the table below. Rule <a href="/Rules/Detail?id=IDENT-04">IDENT-04</a>: no two apps look alike.</p>
        @if (Model.ByHue.Count == 0)
        {
            <p class="mat-muted">There are no apps yet. Add the first one in the Studio and its accent shows here.</p>
        }
        else
        {
            <div class="doc-strip" role="list">
                @foreach (var app in Model.ByHue)
                {
                    <a class="doc-strip__item" role="listitem" href="/Identity/App?id=@app.Id">
                        @Ui.Swatch(app.Accent, "bar")
                        <small>@app.Name</small>
                    </a>
                }
            </div>
        }
    </div>
</section>

<section class="mat-section" aria-labelledby="pairs-title">
    <div class="mat-section__head">
        <h2 id="pairs-title">Too close to tell apart</h2>
        <p class="mat-section__lead">Distance is measured in OKLab (times 10): below 0.05 the colours are identical, below 0.25 hard to tell apart, below @PaletteAdvisor.TooClose.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) still easy to mix up on a small logo or a tab.</p>
    </div>

    <div class="mat-list">
        @if (Model.TotalCollisions == 0)
        {
            @* no pair at all (a site with no app or one app): good news, and no tool to reset *@
            <div class="mat-empty">
                <span class="mat-empty__icon">@Ui.Icon("check-circle")</span>
                <div class="mat-empty__title">No two accents are too close</div>
                <p>@(Model.ByHue.Count < 2 ? "A palette compares apps with one another, and there are fewer than two. " : string.Empty)The pairs that are too close to tell apart are listed here when there are any.</p>
            </div>
        }
        else
        {
            <partial name="_Toolbar" model="Model.Toolbar" />
        }

        @if (Model.TotalCollisions > 0 && Model.Items.Count == 0)
        {
            <div class="mat-empty">
                <span class="mat-empty__icon">@Ui.Icon("check-circle")</span>
                <div class="mat-empty__title">No pair matches</div>
                <a class="mat-btn mat-btn--primary" href="/Identity/Palette">@Ui.Icon("refresh")<span>Reset the tools</span></a>
            </div>
        }
        else if (Model.TotalCollisions > 0)
        {
            <div class="mat-table-wrap">
                <table class="mat-table">
                    <caption class="mat-sr-only">Pairs of apps with similar accents</caption>
                    <thead><tr><th scope="col">One app</th><th scope="col">The other</th><th scope="col" class="mat-num">Distance</th><th scope="col">Verdict</th></tr></thead>
                    <tbody>
                        @foreach (var c in Model.Items)
                        {
                            <tr>
                                <td data-label="One app"><span class="mat-row mat-row--nowrap">@Ui.Swatch(c.A.Accent)<a href="/Identity/App?id=@c.A.Id">@c.A.Name</a><code>@c.A.Accent</code></span></td>
                                <td data-label="The other"><span class="mat-row mat-row--nowrap">@Ui.Swatch(c.B.Accent)<a href="/Identity/App?id=@c.B.Id">@c.B.Name</a><code>@c.B.Accent</code></span></td>
                                <td data-label="Distance" class="mat-num mat-mono">@c.Distance.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</td>
                                <td data-label="Verdict"><span class="mat-pill @PaletteModel.VerdictClass(c.Distance)">@PaletteModel.Verdict(c.Distance)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <partial name="_Pager" model="Model.Pager" />
    </div>
</section>

@if (Model.TotalCollisions > 0)
{
<section class="mat-section" aria-labelledby="suggest-title">
    <div class="mat-section__head">
        <h2 id="suggest-title">Proposals</h2>
        <p class="mat-section__lead">Of each group that is too close, the first app keeps its colour. For the others the advisor picks the colour that is farthest from everything in use and still carries white text at AA. These are proposals: the registry is changed by a person.</p>
    </div>
    <div class="mat-table-wrap">
        <table class="mat-table">
            <caption class="mat-sr-only">Proposed accents</caption>
            <thead><tr><th scope="col">App</th><th scope="col">Now</th><th scope="col">Proposed</th><th scope="col" class="mat-num">Then nearest</th><th scope="col"><span class="mat-sr-only">Try</span></th></tr></thead>
            <tbody>
                @foreach (var s in Model.Suggestions)
                {
                    <tr>
                        <td data-label="App"><span class="mat-table__name">@Ui.Logo(s.App, "sm")<a href="/Identity/App?id=@s.App.Id">@s.App.Name</a></span></td>
                        <td data-label="Now"><span class="mat-row mat-row--nowrap">@Ui.Swatch(s.App.Accent)<code>@s.App.Accent</code></span></td>
                        <td data-label="Proposed"><span class="mat-row mat-row--nowrap">@Ui.Swatch(s.Accent)<code>@s.Accent</code></span></td>
                        <td data-label="Then nearest" class="mat-num">@s.NearestDistance.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) (@s.NearestApp)</td>
                        <td class="mat-table__cell-actions"><div class="mat-table__actions"><a class="mat-btn mat-btn--ghost mat-btn--sm" href="/Builder?accent=@Uri.EscapeDataString(s.Accent)&app=@s.App.Id">@Ui.Icon("wrench")<span>Try it</span></a></div></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Suggestions.Count == 0)
    {
        <div class="mat-alert mat-alert--success">@Ui.Icon("check-circle")<div class="mat-alert__body">No two accents are too close.</div></div>
    }
</section>
}
