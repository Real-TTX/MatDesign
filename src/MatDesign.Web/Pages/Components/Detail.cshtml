@page "/Components/{id}"
@model MatDesign.Web.Pages.ComponentPages.DetailModel
@using MatDesign.Web.Studio
@{
    // The page of one component (LIST-18): the examples, how to use it, the rules it follows, and the way to the neighbours. The id of the component is the id of the
    // element that holds its examples (as on the page of everything), so that a selector like #slot-picker .mat-picker reads the same on both pages.
    // An id that is no component is a 404 with a way back, drawn here so that it is the same with and without the status code pages of the site.
    var c = Model.Doc;
    if (c is null)
    {
        ViewData["Title"] = "Not found";
        ViewData["Crumbs"] = Crumbs.Of(("Toolkit", "/Shell"), ("Components", ComponentCatalog.OverviewPath), ("Not found", null));
    }
    else
    {
        ViewData["Title"] = c.Name + " · Components";
        ViewData["OwnHead"] = true;
        ViewData["Crumbs"] = Crumbs.Of(("Toolkit", "/Shell"), ("Components", ComponentCatalog.OverviewPath), (c.Group, ComponentCatalog.OverviewPath + "#" + ComponentCatalog.GroupAnchor(c.Group)), (c.Name, null));
        ViewData["Width"] = "wide";
        ViewData["IndexDialog"] = "toc-dialog";
    }
}

@if (c is null)
{
    <div class="mat-empty">
        <span class="mat-empty__icon">@Ui.Icon("alert")</span>
        <div class="mat-empty__title">This component does not exist</div>
        <p>The address may be wrong, or the component has been renamed or removed.</p>
        <a class="mat-btn mat-btn--primary" href="@ComponentCatalog.OverviewPath">@Ui.Icon("grid")<span>All components</span></a>
        <a class="mat-btn mat-btn--ghost" href="/">@Ui.Icon("home")<span>Go to the overview</span></a>
    </div>
}
else
{
    var around = Model.Around;
    var hasContext = Model.Context is not null;
    var hasProperties = Model.Properties.Count > 0;

    <div class="mat-page__head doc-head">
        <div class="mat-page__title">
            <h1>@c.Name</h1>
            <p class="mat-page__sub">@c.Summary</p>
        </div>
        @if (ContextPages.Of(c.Id) is not null)
        {
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--sm doc-show" data-context-show="@ComponentCatalog.GroupAnchor(c.Group)" data-context-component="@c.Id">@Ui.Icon("monitor")<span>Show in a page</span></button>
        }
    </div>

    <partial name="_ComponentPager" model="(around, false)" />

    <div class="mat-with-toc">
        <div class="mat-with-toc__main">
            <section class="doc-section mat-anchor" id="toc-examples" aria-labelledby="toc-examples-title">
                <div class="mat-section__head">
                    <h2 id="toc-examples-title">Examples</h2>
                    <p class="mat-section__lead">
                        Every example is live and shows its code with it, to copy: beside the example on a wide window, below it on a narrow one.
                    </p>
                </div>

                <div class="doc-view" role="group" aria-label="Where the code is shown">
                    <span class="doc-view__label">Code</span>
                    <div class="mat-seg">
                        <button type="button" class="mat-seg__btn" data-doc-code="beside" aria-pressed="true"><span>Beside the example</span></button>
                        <button type="button" class="mat-seg__btn" data-doc-code="below" aria-pressed="false"><span>Below it</span></button>
                    </div>
                </div>

                <div class="doc-examples" id="@c.Id">
                    <partial name="_ComponentExamples" model="(c, 3)" />
                </div>
            </section>

            <section class="doc-section mat-anchor" id="toc-how" aria-labelledby="toc-how-title">
                <div class="mat-section__head">
                    <h2 id="toc-how-title">How to use</h2>
                    <p class="mat-section__lead">
                        Copy an example above and keep its structure: the toolkit styles and starts the control by the classes and the attributes that the examples use.
                    </p>
                </div>

                <div class="doc-howto">
                    @if (Model.Classes.Count > 0 || Model.Attributes.Count > 0)
                    {
                        <div class="doc-howto__block">
                            <h3>The markup</h3>
                            <dl class="doc-api doc-api--full">
                                @if (Model.Classes.Count > 0)
                                {
                                    <dt>Classes</dt>
                                    <dd>@foreach (var name in Model.Classes) { <code>@name</code> }</dd>
                                }
                                @if (Model.Attributes.Count > 0)
                                {
                                    <dt>Attributes</dt>
                                    <dd>@foreach (var name in Model.Attributes) { <code>@name</code> }</dd>
                                }
                            </dl>
                        </div>
                    }

                    @if (c.Behaviour.Count > 0)
                    {
                        <div class="doc-howto__block">
                            <h3>How it behaves</h3>
                            <ul class="doc-list">
                                @foreach (var line in c.Behaviour) { <li>@Ui.Rich(line)</li> }
                            </ul>
                        </div>
                    }

                    @if (hasProperties)
                    {
                        <div class="doc-howto__block mat-anchor" id="toc-properties">
                            <h3>Properties</h3>
                            <p>
                                Set these on <code>:root</code>, on <code>[data-app]</code> or on one element to change the shape of the control. Unset, the control uses the default shown
                                (<a href="/Rules/Detail?id=SPACE-06">SPACE-06</a>, <a href="/Foundations/Tokens#component-properties">all properties</a>).
                            </p>
                            <partial name="_ComponentProperties" model="Model.Properties" />
                        </div>
                    }

                    <div class="doc-howto__block">
                        <h3>Where to read more</h3>
                        <ul class="doc-list">
                            <li>The rules below say when to use it and what it has to do; the <a href="/Rules">rulebook</a> has all of them.</li>
                            <li>An app takes the toolkit as files and does not link to it (<a href="/Rules/Detail?id=CODE-03">CODE-03</a>): <a href="/Download">download it</a>; <code>docs/ADOPTING.md</code> in the repository is the checklist for an app that moves over.</li>
                            <li>The <a href="/Patterns">patterns</a> show the controls together in whole pages.</li>
                        </ul>
                    </div>
                </div>
            </section>

            <section class="doc-section mat-anchor" id="toc-rules" aria-labelledby="toc-rules-title">
                <div class="mat-section__head">
                    <h2 id="toc-rules-title">Rules it follows</h2>
                    <p class="mat-section__lead">Each rule has an id that a review, a commit or a prompt can cite.</p>
                </div>

                @if (Model.Rules.Count == 0)
                {
                    <p class="mat-muted">No rule is named for this component yet.</p>
                }
                else
                {
                    <ul class="doc-rulecards">
                        @foreach (var rule in Model.Rules)
                        {
                            <li class="doc-rulecard">
                                <div class="doc-rulecard__head">
                                    <a class="doc-rule-id" href="/Rules/Detail?id=@rule.Id">@rule.Id</a>
                                    <a class="doc-rulecard__title" href="/Rules/Detail?id=@rule.Id">@rule.Title</a>
                                    <span class="mat-pill @Ui.RuleLevelClass(rule.Level)">@rule.Level</span>
                                </div>
                                <p class="doc-rulecard__text">@Ui.Inline(rule.Statement)</p>
                                @if (rule.Do is not null || rule.Dont is not null)
                                {
                                    <div class="doc-dodont">
                                        @if (rule.Do is not null) { <div class="doc-do"><strong>Do</strong>@("\n")@rule.Do</div> }
                                        @if (rule.Dont is not null) { <div class="doc-dont"><strong>Do not</strong>@("\n")@rule.Dont</div> }
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                }
            </section>

            @if (Model.Context is { } context)
            {
                <section class="doc-section mat-anchor" id="toc-page" aria-labelledby="toc-page-title">
                    <div class="mat-section__head">
                        <h2 id="toc-page-title">In a page</h2>
                        <p class="mat-section__lead">The @c.Group.ToLowerInvariant() as they are used in a page of the sample app.</p>
                    </div>
                    <partial name="_ContextPage" model="context" />
                </section>
            }

            <partial name="_ComponentPager" model="(around, true)" />
        </div>

        <aside class="mat-toc-aside" aria-label="Index of this page">
            <partial name="_ComponentIndex" model="(c, around, hasProperties, hasContext)" />
        </aside>
    </div>

    <dialog class="mat-dialog mat-dialog--sm" id="toc-dialog" aria-labelledby="toc-dialog-title">
        <div class="mat-dialog__form">
            <div class="mat-dialog__head">
                @Ui.Icon("list")
                <h2 class="mat-dialog__title" id="toc-dialog-title">On this page</h2>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Close">@Ui.Icon("x")</button>
            </div>
            <div class="mat-dialog__body"><partial name="_ComponentIndex" model="(c, around, hasProperties, hasContext)" /></div>
        </div>
    </dialog>
}

@section Scripts {
    @if (c is not null)
    {
        <script src="/js/doc.js"></script>
        <script src="/js/components.js"></script>
    }
}
