@page "/Components"
@{
    ViewData["Title"] = "Components";
    ViewData["PageIcon"] = "toggle";
    ViewData["PageSub"] = "Every control of the toolkit on one page: live, with the markup to copy and the rules it follows. Jump with the index.";
    ViewData["Crumbs"] = Crumbs.Of(("Toolkit", "/Shell"), ("Components", null));
    ViewData["Width"] = "wide";
}

<div class="mat-with-toc">
    <div class="mat-with-toc__main">
        <div class="mat-toc-bar">
            <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-dialog-open="toc-dialog" aria-haspopup="dialog">@Ui.Icon("list")<span>Jump to a component</span></button>
        </div>

        <div class="mat-alert mat-alert--info">
            @Ui.Icon("info")
            <div class="mat-alert__body">
                <strong>How to read this page.</strong> Every example is the real control: use it. Open <em>Markup</em> to copy the HTML (or the script) of an example.
                The numbers such as <a href="/Rules/Detail?id=FORM-01">FORM-01</a> are the rules of the rulebook that the control follows.
                The <a href="/Patterns">patterns</a> show the controls together in whole pages.
            </div>
        </div>

        @foreach (var group in ComponentCatalog.Groups)
        {
            var anchor = ComponentCatalog.GroupAnchor(group);
            <section class="doc-group mat-anchor" id="@anchor" aria-labelledby="h-@anchor">
                <div class="mat-section__head">
                    <h2 id="h-@anchor">@group</h2>
                    <p class="mat-section__lead">@ComponentCatalog.GroupSummaries[group]</p>
                </div>
                <div class="doc-components">
                    @foreach (var component in ComponentCatalog.All.Where(c => c.Group == group))
                    {
                        <partial name="_Component" model="component" />
                    }
                </div>
            </section>
        }

        <div class="mat-actions">
            <a class="mat-btn mat-btn--secondary" href="/Patterns">@Ui.Icon("template")<span>See them in pages</span></a>
            <a class="mat-btn mat-btn--secondary" href="/Download">@Ui.Icon("download")<span>Download the toolkit</span></a>
        </div>
    </div>

    <aside class="mat-toc-aside" aria-label="Index of the components">
        <partial name="_Toc" />
    </aside>
</div>

<dialog class="mat-dialog mat-dialog--sm" id="toc-dialog" aria-labelledby="toc-dialog-title">
    <div class="mat-dialog__form">
        <div class="mat-dialog__head">
            @Ui.Icon("list")
            <h2 class="mat-dialog__title" id="toc-dialog-title">Jump to a component</h2>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="Close">@Ui.Icon("x")</button>
        </div>
        <div class="mat-dialog__body"><partial name="_Toc" /></div>
    </div>
</dialog>

@section Scripts {
    <script src="/js/doc.js"></script>
}
