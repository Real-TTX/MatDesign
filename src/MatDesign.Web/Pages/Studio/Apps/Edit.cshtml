@page "/Studio/Apps/Edit"
@model MatDesign.Web.Pages.Studio.Apps.EditModel
@inject StudioHistory History
@using MatDesign.Web.Studio
@{
    var input = Model.Input;
    var isNew = Model.IsNew;
    var title = isNew ? "New app" : string.IsNullOrWhiteSpace(input.Name) ? "App" : input.Name!;
    ViewData["Title"] = title;
    ViewData["PageSub"] = isNew
        ? "A new app of the family gets its own colour and icon. Everything else is shared."
        : Model.Source switch
        {
            ItemSource.BuiltIn => "A built-in app. Saving a change here replaces it on the site; deleting that change brings the built-in app back.",
            ItemSource.Changed => "A built-in app that was changed in the Studio. Resetting it brings the built-in app back.",
            _ => "An app that was added in the Studio.",
        };
    ViewData["Crumbs"] = Crumbs.Of(("Studio", "/Studio"), ("Apps", "/Studio/Apps"), (title, null));
    ViewData["Width"] = "narrow";

    string Field(string name) => Model.ProblemFor(name) is null ? string.Empty : " is-invalid";
}

@* The action is written out: after Check the address of the page ends in ?check=true, and Save must not inherit it. A form with an action gets no token by itself. *@
<form class="mat-form" method="post" action="/Studio/Apps/Edit" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" name="Input.Original" value="@input.Original" />

    <div class="mat-alert mat-alert--danger" role="alert" data-validation-summary hidden="@(Model.Problems.Count == 0)">
        @Ui.Icon("x-circle")
        <div class="mat-alert__body">
            <strong>Please check the form.</strong>
            <ul class="mat-alert__list">
                @foreach (var problem in Model.Problems)
                {
                    <li><a href="#@EditModel.TargetOf(problem.Field)">@(problem.Field.Contains(':') ? problem.Field.Replace(":", " ") + ": " : string.Empty)@problem.Message</a></li>
                }
            </ul>
        </div>
    </div>
    @if (Model.Checked && Model.Problems.Count == 0)
    {
        <div class="mat-alert mat-alert--success" role="status">@Ui.Icon("check-circle")<div class="mat-alert__body"><strong>All checks pass.</strong> Nothing was saved yet.</div></div>
    }

    <section class="mat-card" aria-labelledby="app-title">
        <div class="mat-card__head">@Ui.Icon("apps")<h2 class="mat-card__title" id="app-title">The app</h2></div>
        <div class="mat-card__body">
            <div class="mat-form__grid">
                <div class="mat-field@(Field("Name"))">
                    <label class="mat-label" for="Input_Name">Name <span class="mat-req" aria-hidden="true">*</span></label>
                    <input class="mat-input" id="Input_Name" name="Input.Name" value="@input.Name" maxlength="40" required data-msg-required="Please give the app a name." />
                    <span class="mat-error" aria-live="polite">@Model.ProblemFor("Name")</span>
                    <span class="mat-hint">Written as in its menu, its title and its README (IDENT-06).</span>
                </div>
                <div class="mat-field@(Field("Id"))">
                    <label class="mat-label" for="Input_Id">Id @if (isNew) { <span class="mat-req" aria-hidden="true">*</span> }</label>
                    <input class="mat-input mat-mono" id="Input_Id" name="Input.Id" value="@input.Id" maxlength="24" readonly="@(!isNew)" required="@isNew" pattern="[a-z]{2,24}" data-msg-pattern="Use 2 to 24 lower-case letters." data-msg-required="Please give the app an id." autocomplete="off" />
                    <span class="mat-error" aria-live="polite">@Model.ProblemFor("Id")</span>
                    <span class="mat-hint">@(isNew ? "Lower-case letters, like matmail. It is the value of data-app and the id in the API, and it cannot change later." : "The value of data-app and the id in the API. It cannot change.")</span>
                </div>
                <div class="mat-field mat-field--full@(Field("Tagline"))">
                    <label class="mat-label" for="Input_Tagline">Tagline <span class="mat-req" aria-hidden="true">*</span></label>
                    <input class="mat-input" id="Input_Tagline" name="Input.Tagline" value="@input.Tagline" maxlength="90" required data-msg-required="Please say what the app is for." />
                    <span class="mat-error" aria-live="polite">@Model.ProblemFor("Tagline")</span>
                </div>
                <div class="mat-field@(Field("Category"))">
                    <label class="mat-label" for="Input_Category">Category</label>
                    <select class="mat-select" id="Input_Category" name="Input.Category">
                        @foreach (var category in MatDesign.Core.AppRegistry.Categories)
                        {
                            <option value="@category" selected="@(category == input.Category)">@category</option>
                        }
                    </select>
                    <span class="mat-error" aria-live="polite">@Model.ProblemFor("Category")</span>
                </div>
                <div class="mat-field@(Field("Glyph"))">
                    <label class="mat-label" for="Input_Glyph">Icon</label>
                    <select class="mat-select" id="Input_Glyph" name="Input.Glyph">
                        @foreach (var glyph in Model.Glyphs)
                        {
                            <option value="@glyph" selected="@(glyph == input.Glyph)">@glyph</option>
                        }
                    </select>
                    <span class="mat-error" aria-live="polite">@Model.ProblemFor("Glyph")</span>
                    <span class="mat-hint">The glyph of the logo, from the icon sprite.</span>
                </div>
                <div class="mat-field@(Field("Repo"))">
                    <label class="mat-label" for="Input_Repo">Repository <span class="mat-opt">(optional)</span></label>
                    <input class="mat-input mat-mono" id="Input_Repo" name="Input.Repo" value="@input.Repo" maxlength="60" />
                    <span class="mat-error" aria-live="polite">@Model.ProblemFor("Repo")</span>
                    <span class="mat-hint">Empty means the name of the app.</span>
                </div>
                <div class="mat-field@(Field("Port"))">
                    <label class="mat-label" for="Input_Port">Port <span class="mat-opt">(optional)</span></label>
                    <input class="mat-input mat-mono" id="Input_Port" name="Input.Port" value="@input.Port" inputmode="numeric" maxlength="5" />
                    <span class="mat-error" aria-live="polite">@Model.ProblemFor("Port")</span>
                    <span class="mat-hint">The web port of the app; no two apps share one.</span>
                </div>
            </div>
        </div>
    </section>

    <section class="mat-card" aria-labelledby="colour-title">
        <div class="mat-card__head">@Ui.Icon("palette")<h2 class="mat-card__title" id="colour-title">Colour</h2></div>
        <div class="mat-card__body">
            <div class="mat-form__grid">
                <div class="mat-field@(Field("Accent"))">
                    <label class="mat-label" for="Input_Accent">Accent <span class="mat-req" aria-hidden="true">*</span></label>
                    <div class="mat-picker" data-picker="colour" data-placeholder="Choose a colour">
                        <input class="mat-picker__input" id="Input_Accent" name="Input.Accent" value="@input.Accent" />
                    </div>
                    <span class="mat-error" aria-live="polite">@Model.ProblemFor("Accent")</span>
                    <span class="mat-hint">The one colour the app chooses (IDENT-01). The picker tells how white and dark text read on it.</span>
                </div>
                <div class="mat-field@(Field("OnAccent"))">
                    <label class="mat-label" for="Input_OnAccent">Text on the accent <span class="mat-opt">(optional)</span></label>
                    <div class="mat-picker" data-picker="colour" data-clearable data-placeholder="White">
                        <input class="mat-picker__input" id="Input_OnAccent" name="Input.OnAccent" value="@input.OnAccent" />
                    </div>
                    <span class="mat-error" aria-live="polite">@Model.ProblemFor("OnAccent")</span>
                    <span class="mat-hint">Empty means white. A dark colour for an accent that is too light for white text (IDENT-02).</span>
                </div>
                <div class="mat-field@(Field("AccentText"))">
                    <label class="mat-label" for="Input_AccentText">Link colour <span class="mat-opt">(optional)</span></label>
                    <div class="mat-picker" data-picker="colour" data-clearable data-placeholder="Derived from the accent">
                        <input class="mat-picker__input" id="Input_AccentText" name="Input.AccentText" value="@input.AccentText" />
                    </div>
                    <span class="mat-error" aria-live="polite">@Model.ProblemFor("AccentText")</span>
                    <span class="mat-hint">Only when a link in the accent is too light on white.</span>
                </div>
                <div class="mat-field">
                    <span class="mat-label">As typed</span>
                    @if (Model.Preview is { } preview && MatDesign.Core.Studio.AppValidator.IsSafe(preview))
                    {
                        <span class="mat-row mat-row--nowrap">@Ui.Swatch(preview.Accent, "lg")<span><strong>@preview.Name</strong><small class="mat-muted"> @preview.Accent</small></span></span>
                    }
                    else
                    {
                        <span class="mat-hint">Appears when the colours are colours.</span>
                    }
                </div>
            </div>
        </div>
    </section>

    @if (Model.Report is { } report)
    {
        <partial name="_ContrastCard" model="report" />
    }

    <section class="mat-card" aria-labelledby="note-title">
        <div class="mat-card__head">@Ui.Icon("file-text")<h2 class="mat-card__title" id="note-title">Note</h2></div>
        <div class="mat-card__body">
            <div class="mat-field@(Field("Notes"))">
                <label class="mat-label" for="Input_Notes">Note <span class="mat-opt">(optional)</span></label>
                <textarea class="mat-textarea" id="Input_Notes" name="Input.Notes" rows="3" maxlength="300">@input.Notes</textarea>
                <span class="mat-error" aria-live="polite">@Model.ProblemFor("Notes")</span>
                <span class="mat-hint">Shown on the page of the app. Up to 300 characters.</span>
            </div>
        </div>
    </section>

    @* What the app sets for itself on top of the brand. The marker tells the server that this section was sent, so that a post without it leaves the overrides alone. *@
    <input type="hidden" name="overrides-present" value="1" />
    <section class="mat-card doc-overrides" aria-labelledby="overrides-title" data-brand-editor>
        <div class="mat-card__head">@Ui.Icon("sliders")<h2 class="mat-card__title" id="overrides-title">Overrides of this app</h2><span class="mat-muted">@(Model.OverrideCount == 0 ? "nothing set" : Model.OverrideCount + " set")</span></div>
        <div class="mat-card__body">
            <p class="mat-muted">
                The look of an app is the toolkit's, then the brand's (<a href="/Studio/Brand">tokens</a> and <a href="/Studio/Brand/Components">component properties</a>), then what this app sets here, and last a colour scheme the user chooses.
                An app owns its accent and its shape: radii, spacing, type, motion and the properties of single controls. The surfaces, lines and text are the brand's, so the apps of the company stay one family; they are not offered here.
                Leave a field empty to keep what the brand gives; what you type shows in the control beside it at once. An app that sets nothing writes nothing. Limits are those of the brand editor:
                a height under 44 px (not under 32 px) is written for a mouse only, so a touch screen keeps its 44 px (<a href="/Rules/Detail?id=MOBILE-04">MOBILE-04</a>).
            </p>

            <div class="mat-accordion"><details class="mat-accordion__item" id="override-tokens" open="@(Model.TokenCount > 0 || Model.Problems.Any(p => p.Field.StartsWith("Light:", StringComparison.Ordinal) || p.Field.StartsWith("Dark:", StringComparison.Ordinal)))">
                <summary>Shape, spacing, type and motion<span class="mat-muted"> (@Model.OverrideTokens.Count tokens)</span>@Ui.Icon("chevron-down", "mat-accordion__chev")</summary>
                <div class="mat-accordion__body">
                    <div class="mat-table-wrap">
                        <table class="mat-table doc-comp-table">
                            <caption class="mat-sr-only">Tokens this app may set</caption>
                            <thead><tr><th scope="col">Token</th><th scope="col">Brand and toolkit</th><th scope="col">Value</th><th scope="col"><span class="mat-sr-only">Reset</span></th></tr></thead>
                            <tbody>
                                @foreach (var token in Model.OverrideTokens)
                                {
                                    var fieldName = "Light:" + token.Name;
                                    <tr data-brand-row data-token="@token.Name" data-kind="@token.Kind.ToString().ToLowerInvariant()" data-light="@token.Light" data-dark="@token.Dark">
                                        <td data-label="Token">
                                            <div class="mat-table__name"><span><code>@token.Name</code><small>@token.Description</small><small class="mat-muted">@token.Hint</small></span></div>
                                        </td>
                                        <td data-label="Brand and toolkit"><span class="doc-brand__default"><code>@token.Light</code></span></td>
                                        <td data-label="Value">
                                            <div class="mat-field@(Field(fieldName))">
                                                <input class="mat-input mat-mono" id="@EditModel.TokenId(token, false)" name="light:@token.Name" value="@Model.TokenValue(token, false)" placeholder="@token.Light" maxlength="@MatDesign.Core.Studio.BrandValidator.MaxValueLength" autocomplete="off" spellcheck="false" data-brand-input="light" aria-label="Value of @token.Name" />
                                                <span class="mat-error" aria-live="polite">@Model.ProblemFor(fieldName)</span>
                                            </div>
                                            @if (token.HasDark)
                                            {
                                                var darkName = "Dark:" + token.Name;
                                                <div class="mat-field@(Field(darkName))">
                                                    <input class="mat-input mat-mono" id="@EditModel.TokenId(token, true)" name="dark:@token.Name" value="@Model.TokenValue(token, true)" placeholder="@token.Dark" maxlength="@MatDesign.Core.Studio.BrandValidator.MaxValueLength" autocomplete="off" spellcheck="false" data-brand-input="dark" aria-label="Dark value of @token.Name" />
                                                    <span class="mat-error" aria-live="polite">@Model.ProblemFor(darkName)</span>
                                                </div>
                                            }
                                        </td>
                                        <td data-label="Reset" class="mat-table__cell-actions">
                                            <div class="mat-table__actions"><button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" data-brand-reset aria-label="Reset @token.Name to the brand's value" data-tip="Reset">@Ui.Icon("restore")</button></div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </details></div>

            <h3 class="doc-comp__title">Component properties</h3>
            <div class="mat-accordion">
                @foreach (var group in Model.PropertyGroups)
                {
                    var editor = new PropertyGroupEditor(group, Model.PropertyValue, Model.ProblemFor, "property", null, string.IsNullOrEmpty(input.Id) || isNew ? null : input.Id, Stacked: true);
                    var count = Model.SetIn(group);
                    <details class="mat-accordion__item" id="override-@group.Component.Id" open="@(count > 0 || Model.Problems.Any(p => group.Properties.Any(x => p.Field == "Property:" + x.Name)))">
                        <summary>@group.Component.Title<span class="mat-muted"> (@(count == 0 ? group.Properties.Count + " properties" : count + " set"))</span>@Ui.Icon("chevron-down", "mat-accordion__chev")</summary>
                        <div class="mat-accordion__body"><partial name="_PropertyGroup" model="editor" /></div>
                    </details>
                }
            </div>
        </div>
    </section>

    <div class="mat-btn-row">
        <button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("save")<span>Save</span></button>
        <button type="submit" class="mat-btn mat-btn--secondary" formaction="?check=true">@Ui.Icon("check-circle")<span>Check</span></button>
        <a class="mat-btn mat-btn--secondary" href="/Studio/Apps">@Ui.Icon("back")<span>Back</span></a>
        @if (!isNew && !string.IsNullOrEmpty(input.Id))
        {
            <a class="mat-btn mat-btn--ghost" href="/Preview?app=@input.Id&amp;view=list">@Ui.Icon("eye")<span>Preview</span></a>
        }
        @if (!isNew && History.HasHistory("apps", input.Id ?? string.Empty))
        {
            <a class="mat-btn mat-btn--ghost" href="@StudioHistory.HistoryUrl("apps", input.Id!)">@Ui.Icon("restore")<span>History</span></a>
        }
        @if (!isNew && Model.Source != ItemSource.BuiltIn)
        {
            <span class="mat-btn-row__spacer"></span>
            @if (Model.Source == ItemSource.Added)
            {
                <button type="submit" class="mat-btn mat-btn--danger" formaction="?handler=Delete" data-confirm="Delete @input.Name? Its page, its colours and its entry in the API are gone; the history stays." data-confirm-ok="Delete">@Ui.Icon("trash")<span>Delete</span></button>
            }
            else
            {
                <button type="submit" class="mat-btn mat-btn--danger" formaction="?handler=Delete" data-confirm="Reset @input.Name to the built-in app? Your changes are gone; the history stays." data-confirm-ok="Reset">@Ui.Icon("restore")<span>Reset to built-in</span></button>
            }
        }
    </div>
</form>

@section Scripts {
    <script src="/js/brand.js"></script>
}
